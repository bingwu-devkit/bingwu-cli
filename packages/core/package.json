{
  "name": "bingwu-cli",
  "version": "0.2.0",
  "description": "收藏 GitHub 模板与第三方脚手架，快速创建项目",
  "homepage": "https://github.com/bingwu-devkit/bingwu-workspace#readme",
  "bugs": "https://github.com/bingwu-devkit/bingwu-workspace/issues",
  "license": "MIT",
  "author": "BINGWU2003",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bingwu-devkit/bingwu-workspace.git",
    "directory": "packages/core"
  },
  "bin": {
    "bingwu": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "pnpm build && publint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "commander": "catalog:",
    "env-paths": "catalog:",
    "execa": "catalog:",
    "giget": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  }
}
