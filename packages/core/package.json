{
  "name": "bingwu-core",
  "version": "0.1.0",
  "description": "bingwu 的模板读取、配置校验和项目创建 API",
  "homepage": "https://github.com/bingwu-devkit/bingwu-cli#readme",
  "bugs": "https://github.com/bingwu-devkit/bingwu-cli/issues",
  "license": "MIT",
  "author": "BINGWU2003",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bingwu-devkit/bingwu-cli.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "pnpm build && publint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "execa": "catalog:",
    "giget": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  }
}
