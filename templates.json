      "repo": "https://github.com/bingwu-templates/art-design-pro-thin",
      "ref": "main"
    },
    {
      "id": "tanstack-shadcn-admin-dashboard",
      "name": "TanStack Shadcn Admin Dashboard",
      "type": "github",
      "repo": "https://github.com/arhamkhnz/tanstack-shadcn-admin-dashboard",
